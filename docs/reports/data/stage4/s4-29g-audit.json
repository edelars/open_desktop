  "questions": [
    {
      "id": "io_delay_default_type",
      "question": "Which io_delay type does the selected config use by default, and is port 0x80 touched on the boot path?",
      "decision": "Default is 0xED (CONFIG_IO_DELAY_0XED=y), not 0x80. outb_p/inb_p delays go to port 0xED (explicit absent device, read 0xFF, write ignored). Do not pass io_delay= in the cmdline. The 0x80 sink stays as a safety net for real-mode setup code (arch/x86/boot) or an explicit io_delay=0x80.",
      "plan_discrepancy": "STAGE_4.md decision 7 and the S4-29b report expect the default to be 0x80; the selected config says 0xED.",
      "evidence": [
        {
          "file": "config",
          "line": 13256,
          "excerpt_short": "CONFIG_IO_DELAY_0XED=y"
        },
        {
          "file": "config",
          "line": 13255,
          "excerpt_short": "# CONFIG_IO_DELAY_0X80 is not set"
        },
