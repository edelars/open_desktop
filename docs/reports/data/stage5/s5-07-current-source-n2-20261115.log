target/release/od-runner linux-direct --test-runs 2 --series-id stage5-s5-07-stage4a-auto-compare-20261115-b --scenario-id stage4-init-nonce --expected-stop-kind budget_exhausted --out work/stage5/stage5-s5-07-stage4a-auto-compare-20261115-b/series.json --vmlinuz /Users/senya/projects/open_desktop/work/stage4/linux-7.0.0-38.38/vmlinuz-7.0.0-38-generic --initramfs /Users/senya/projects/open_desktop/work/stage4/initramfs/initramfs.cpio --acpi-blob tests/fixtures/guest/stage4/acpi_blob/stage4_acpi_blob.bin --expected-vmlinuz-sha256 9f55ef7253055a9cf68f8a04323c93dead2fca617386d842fbde9ca7b178b27e --expected-initramfs-sha256 ee9183a4eded3c16a8c6a7a81c6d5bb79be8bb023f793f7cd61694ea2bd3e588 --expected-acpi-manifest-hash 2bd690ae0817705b1b128675f9628dd7212fee74ab97c88da3599a1ae8e398f2 --ram-mib 128 --run --budget 3000000000 --set-cpl0 --cpuid-profile stage4a --user-mode
